# ---------------------------------------------------------------------------
# Nexus — PRODUCTION environment (APP_ENV=production)
# ---------------------------------------------------------------------------
# Production is deployed to Vercel by .github/workflows/deploy-production.yml
# (currently INACTIVE — see that file's header to activate). The workflow
# injects these values via --dart-define from GitHub repo secrets:
#
#   PRODUCTION_SUPABASE_URL       -> --dart-define=SUPABASE_URL
#   PRODUCTION_SUPABASE_ANON_KEY  -> --dart-define=SUPABASE_ANON_KEY
#
# Vercel deploy also needs (set as GitHub repo secrets):
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
#
# Only the Supabase ANON (publishable) key belongs in a client build; RLS
# enforces access. Never put the service-role key here.

APP_ENV=production
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key-here
