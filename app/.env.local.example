# ---------------------------------------------------------------------------
# Nexus — LOCAL environment (APP_ENV=local)
# ---------------------------------------------------------------------------
# Flutter Web does not read dotenv files at runtime. Config is compiled in via
# --dart-define at build/run time. This file documents the values you pass.
#
# The idiomatic local workflow uses --dart-define-from-file with a JSON file.
# Copy this template's values into `app/dart_define.local.json` (gitignored):
#
#   {
#     "APP_ENV": "local",
#     "SUPABASE_URL": "http://127.0.0.1:54321",
#     "SUPABASE_ANON_KEY": "<anon key from `supabase start`>"
#   }
#
# Then run:
#   flutter run -d chrome --dart-define-from-file=dart_define.local.json
#
# Get SUPABASE_ANON_KEY from `supabase status` after `supabase start`.
# Never commit real keys; only *.example templates are committed.

APP_ENV=local
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-here
