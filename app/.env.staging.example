# ---------------------------------------------------------------------------
# Nexus — STAGING environment (APP_ENV=staging)
# ---------------------------------------------------------------------------
# Staging is deployed to GitHub Pages by .github/workflows/deploy-staging.yml
# on every push to `main`. The workflow injects these values via --dart-define
# from GitHub repo secrets:
#
#   STAGING_SUPABASE_URL       -> --dart-define=SUPABASE_URL
#   STAGING_SUPABASE_ANON_KEY  -> --dart-define=SUPABASE_ANON_KEY
#
# Set them at: Settings -> Secrets and variables -> Actions.
# Only the Supabase ANON (publishable) key belongs here; RLS enforces access.
# Never put the service-role key in a client build.
#
# For a local build that targets the staging Supabase project, copy these into
# `app/dart_define.staging.json` (gitignored) and run:
#   flutter run -d chrome --dart-define-from-file=dart_define.staging.json

APP_ENV=staging
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key-here
